#!/bin/bash

# Enable strict mode:
# -e: exit immediately if any command fails (non-zero exit status)
# -u: report an error and exit when an undefined variable is used
# -o pipefail: a pipeline fails if any command in it fails
set -euo pipefail

# Marker file path used to tell whether firmware processing has already completed, preventing repeated runs
MARKER_FILE="/var/lib/.fw-setup-completed"
FIRMWARE_DIR="/lib/firmware"

# Define terminal color variables so messages stand out
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # Reset color

# Error handler: print the error message in red and exit the script
error_exit() {
    echo -e "${RED}Error: $1${NC}" >&2
    # If the script fails midway, remove any leftover marker file for safety
    rm -f "$MARKER_FILE"
    exit 1
}

# Permission check: make sure the script runs as root (sudo)
if [ "$EUID" -ne 0 ]; then
    error_exit "This script must be run as root (use sudo)"
fi

echo -e "${GREEN}Starting firmware configuration...${NC}"
echo ""

# ---------------------------------------------------------
# Step 0: Check for and install the zstd decompression tool
# ---------------------------------------------------------
echo -e "${YELLOW}Step 0: Checking for the zstd decompression tool...${NC}"
if ! command -v zstd >/dev/null 2>&1; then
    echo -e "${YELLOW}  zstd not found, installing...${NC}"
    echo ""
    if ! apt-get update; then
        error_exit "Failed to update the package list (to install zstd)"
    fi
    echo ""
    if ! apt-get install -y zstd; then
        error_exit "Failed to install the zstd package"
    fi
    echo ""
    echo -e "${GREEN}✓ zstd installed${NC}"
else
    echo -e "${GREEN}✓ zstd is already installed${NC}"
fi
echo ""

# ---------------------------------------------------------
# Step 1: Install the linux-firmware package
# ---------------------------------------------------------
echo -e "${YELLOW}Step 1: Installing linux-firmware (the official Linux firmware collection)...${NC}"
echo ""
if ! apt-get update; then
    error_exit "Failed to update the package list"
fi
echo ""
if ! apt-get install -y linux-firmware; then
    error_exit "Failed to install the linux-firmware package"
fi
echo ""

# Verify that the firmware directory was created successfully
if [ ! -d "$FIRMWARE_DIR" ]; then
    error_exit "Firmware directory $FIRMWARE_DIR does not exist"
fi

echo -e "${GREEN}✓ linux-firmware installed${NC}"
echo ""

# ---------------------------------------------------------
# Step 2: Find and decompress every real .zst archive (excluding symlinks)
# ---------------------------------------------------------
echo -e "${YELLOW}Step 2: Decompressing .zst firmware archives...${NC}"
echo ""
decompressed_count=0

# Create two temporary files to hold the find results (more compatible than process substitution)
TEMP_FILE=$(mktemp)
TEMP_FILE2=$(mktemp)
# Use trap to ensure both temporary files are cleaned up however the script exits
trap "rm -f '$TEMP_FILE' '$TEMP_FILE2'" EXIT

# Find every "regular file" ending in .zst (-type f, excluding symlinks)
# -print0 together with read -d '' handles filenames containing spaces perfectly
find "$FIRMWARE_DIR" -type f -name "*.zst" -print0 2>/dev/null > "$TEMP_FILE" || true

while IFS= read -r -d '' zst_file; do
    # Double-check and skip symlinks (extra safety)
    if [ -L "$zst_file" ]; then
        continue
    fi

    # Derive the target filename by stripping the .zst suffix (e.g. wifi.bin.zst -> wifi.bin)
    target_file="${zst_file%.zst}"

    # Skip if the decompressed file already exists
    if [ -e "$target_file" ]; then
        echo -e "${YELLOW}  Skipping $zst_file (target file already exists)${NC}"
        continue
    fi

    # Decompress (-d means decompress, -o sets the output path)
    if zstd -d "$zst_file" -o "$target_file" 2>/dev/null; then
        # Verify that decompression succeeded
        if [ -f "$target_file" ]; then
            # On success, delete the original .zst archive to save space
            rm -f "$zst_file"
            decompressed_count=$((decompressed_count + 1))
        else
            error_exit "Failed to decompress $zst_file: target file was not created"
        fi
    else
        error_exit "Could not decompress $zst_file"
    fi
done < "$TEMP_FILE"

echo ""
echo -e "${GREEN}✓ Decompressed $decompressed_count archive(s)${NC}"
echo ""

# ---------------------------------------------------------
# Step 3: Handle symlinks that end in .zst
# ---------------------------------------------------------
# This is the most complex part: once the original files are decompressed, every symlink pointing at .zst becomes dangling and must be retargeted
echo -e "${YELLOW}Step 3: Handling .zst symlinks...${NC}"
echo ""
symlink_count=0

# Find every "symlink" that ends in .zst (-type l)
find "$FIRMWARE_DIR" -type l -name "*.zst" -print0 2>/dev/null > "$TEMP_FILE2" || true

while IFS= read -r -d '' symlink_path; do
    # Get the target path the symlink currently points to
    target_path=$(readlink "$symlink_path")

    # If it is a relative path, resolve it to an absolute path
    if [[ "$target_path" != /* ]]; then
        symlink_dir=$(dirname "$symlink_path")
        target_path=$(realpath -m "$symlink_dir/$target_path")
    fi

    # Try to locate the real file target in several possible locations
    original_target="$target_path"
    found_target=""

    # Check whether the original target path exists
    if [ -e "$target_path" ]; then
        found_target="$target_path"
    fi

    # If it points under /usr/lib/firmware/, try /lib/firmware/ (handles Debian's usr-merge)
    if [ -z "$found_target" ] && [[ "$target_path" == /usr/lib/firmware/* ]]; then
        alt_path="/lib/firmware/${target_path#/usr/lib/firmware/}"
        if [ -e "$alt_path" ]; then
            found_target="$alt_path"
        fi
    fi

    # If still not found and the target is a .zst, check whether its corresponding "decompressed version" exists
    if [ -z "$found_target" ] && [[ "$target_path" == *.zst ]]; then
        # Check the decompressed version in the original directory
        decompressed_path="${target_path%.zst}"
        if [ -e "$decompressed_path" ]; then
            found_target="$decompressed_path"
        fi

        # Check the decompressed version under /lib/firmware/
        if [ -z "$found_target" ] && [[ "$target_path" == /usr/lib/firmware/* ]]; then
            alt_decompressed="/lib/firmware/${decompressed_path#/usr/lib/firmware/}"
            if [ -e "$alt_decompressed" ]; then
                found_target="$alt_decompressed"
            fi
        fi
    fi

    # If still not found, try extracting the relative path and searching under /lib/firmware
    if [ -z "$found_target" ] && [[ "$target_path" != /lib/firmware/* ]]; then
        if [[ "$target_path" == /* ]]; then
            rel_path="${target_path#/}"
            alt_path="/lib/firmware/$rel_path"
            if [ -e "$alt_path" ]; then
                found_target="$alt_path"
            fi
        fi
    fi

    # Exhausted every option and still not found: it is a dead link, skip it
    if [ -z "$found_target" ]; then
        echo -e "${YELLOW}  Warning: symlink $symlink_path points to a nonexistent target $original_target${NC}"
        continue
    fi

    target_path="$found_target"

    # If the target is itself a symlink, resolve it in a loop until the final real file
    # (the lookup logic here matches the search above)
    while [ -L "$target_path" ]; do
        link_target=$(readlink "$target_path")
        if [[ "$link_target" != /* ]]; then
            link_dir=$(dirname "$target_path")
            link_target=$(realpath -m "$link_dir/$link_target")
        fi

        original_link="$link_target"
        found_link=""

        if [ -e "$link_target" ]; then found_link="$link_target"; fi

        if [ -z "$found_link" ] && [[ "$link_target" == /usr/lib/firmware/* ]]; then
            alt_path="/lib/firmware/${link_target#/usr/lib/firmware/}"
            if [ -e "$alt_path" ]; then found_link="$alt_path"; fi
        fi

        if [ -z "$found_link" ] && [[ "$link_target" == *.zst ]]; then
            decompressed_path="${link_target%.zst}"
            if [ -e "$decompressed_path" ]; then
                found_link="$decompressed_path"
            fi

            if [ -z "$found_link" ] && [[ "$link_target" == /usr/lib/firmware/* ]]; then
                alt_decompressed="/lib/firmware/${decompressed_path#/usr/lib/firmware/}"
                if [ -e "$alt_decompressed" ]; then
                    found_link="$alt_decompressed"
                fi
            fi
        fi

        if [ -z "$found_link" ]; then
            # Cannot resolve it: stop and use the target found so far
            break
        fi
        target_path="$found_link"
    done

    # If the target finally reached is still a .zst file, decompress it here
    if [[ "$target_path" == *.zst ]] && [ -f "$target_path" ] && [ ! -L "$target_path" ]; then
        decompressed_target="${target_path%.zst}"

        if [ -e "$decompressed_target" ]; then
            echo -e "${YELLOW}  Target already decompressed: $decompressed_target${NC}"
            target_path="$decompressed_target"
        else
            if zstd -d "$target_path" -o "$decompressed_target" 2>/dev/null; then
                if [ -f "$decompressed_target" ]; then
                    rm -f "$target_path"
                    target_path="$decompressed_target"
                else
                    error_exit "Failed to decompress final target $target_path"
                fi
            else
                error_exit "Failed to decompress final target $target_path"
            fi
        fi
    fi

    # Compute the new symlink path (strip the .zst suffix)
    new_symlink_path="${symlink_path%.zst}"

    # Skip if the new symlink path is already occupied by a real file
    if [ -e "$new_symlink_path" ] && [ ! -L "$new_symlink_path" ]; then
        echo -e "${YELLOW}  Skipping $symlink_path (target file already exists)${NC}"
        continue
    fi

    # Compute the [relative path] from the new symlink location to the real target file
    new_symlink_dir=$(dirname "$new_symlink_path")
    relative_target=$(realpath --relative-to="$new_symlink_dir" "$target_path" 2>/dev/null || echo "$target_path")

    # Remove the old broken symlink that still has the .zst suffix
    rm -f "$symlink_path"

    # Create a new symlink (without the .zst suffix) pointing at the decompressed real file
    if ln -sf "$relative_target" "$new_symlink_path"; then
        symlink_count=$((symlink_count + 1))
    else
        error_exit "Could not create symlink $new_symlink_path -> $relative_target"
    fi

done < "$TEMP_FILE2"

echo ""
echo -e "${GREEN}✓ Processed $symlink_count symlink(s)${NC}"
echo ""

# ---------------------------------------------------------
# Step 4: Create the completion marker file
# ---------------------------------------------------------
echo -e "${YELLOW}Step 4: Creating the completion marker...${NC}"
echo ""
if mkdir -p "$(dirname "$MARKER_FILE")" && touch "$MARKER_FILE"; then
    echo -e "${GREEN}✓ Marker file created: $MARKER_FILE${NC}"
else
    error_exit "Failed to create the marker file"
fi
echo ""

# All done
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}Firmware configuration completed successfully!${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "  Decompressed archives: $decompressed_count"
echo -e "  Symlinks processed: $symlink_count"
echo -e "  Completion marker: $MARKER_FILE"
echo ""

exit 0
